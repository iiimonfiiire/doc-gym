# Copy to .env (install.sh does this) and fill in. .env is gitignored.
# The same file is copied to the server by ops/deploy-server.sh.

# --- Required ---
GROQ_API_KEY=
# Shared secret between Obsidian and the Doc Gym service. install.sh generates it.
DOC_GYM_TOKEN=
# Absolute path to your Obsidian vault (desktop only).
DOC_GYM_VAULT=
# Where Obsidian reaches the service, comma-separated, tried in order.
# Put an address that works everywhere first (e.g. a Tailscale IP), then a LAN one.
DOC_GYM_SERVICE_URLS=http://my-server:8765
# SSH target for ops/deploy-server.sh.
DEPLOY_HOST=user@my-server

# --- Optional ---
# Ollama as seen from where the scripts run. The service unit sets localhost on the server.
# OLLAMA_URL=http://my-server:11434
# OLLAMA_MODEL=llama3.2:3b
# Cap Ollama threads on hosts that run hot.
# OLLAMA_NUM_THREAD=2
# DEPLOY_DIR=doc-gym
# GEMINI_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Obsidian > Settings > Local REST API > API Key. Only used by the desktop CLIs.
# OBSIDIAN_REST_TOKEN=
